APP_NAME="Mini Booking"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Omsk
APP_LOCALE=ru
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/app/database.sqlite
DB_FOREIGN_KEYS=true
